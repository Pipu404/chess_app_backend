NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/chess-app
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COACH_REGISTRATION_CODE=replace-with-a-private-code-of-at-least-12-characters
CLIENT_ORIGIN=http://localhost:3000

# For unrelated production domains (for example vercel.app + onrender.com):
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-frontend.vercel.app
# COOKIE_SAME_SITE=none

# For multiple trusted frontend origins, use a comma-separated allowlist:
# CLIENT_ORIGINS=https://app.example.com,https://www.example.com
